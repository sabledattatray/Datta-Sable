# eBook module flags default off. Select the intended payment mode explicitly.
EBOOK_STORE_ENABLED=false
EBOOK_PAYMENT_MODE=test
EBOOK_LIVE_CHECKOUT_APPROVED=false
# Optional reuse of /api/commerce/webhook when RAZORPAY_KEY_ID is live and
# RAZORPAY_WEBHOOK_SECRET matches that already registered live endpoint.
# Otherwise configure the separate /api/commerce/webhook/live endpoint below.
EBOOK_USE_ACTIVE_LIVE_WEBHOOK=false
# Expose the global nav entry only after functional readiness review.
EBOOK_STORE_NAV_ENABLED=false
# Generate a cryptographically random server-only value of at least 32 characters.
EBOOK_ACCESS_SECRET=
# Existing private Vercel Blob store; never use a public-store token here.
COMMERCE_BLOB_READ_WRITE_TOKEN=
# Existing commerce configuration; explicit live mode uses the separate live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=
COMMERCE_TEST_CHECKOUT_ENABLED=true
COMMERCE_APPROVED_CURRENCIES=INR
COMMERCE_SENDER_VERIFIED=false
COMMERCE_POLICIES_APPROVED=false
COMMERCE_ADMIN_EMAIL=
COMMERCE_SITE_URL=
CRON_SECRET=
# Use the existing verified Resend or SMTP sender configuration.
# Never set COMMERCE_SENDER_VERIFIED or COMMERCE_POLICIES_APPROVED without review.
